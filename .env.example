# Local development settings. Copy this file to .env; never commit .env.
# Nothing here is a real secret: these values only work on your own machine.
# Two values are left for you to make, because this file is public: APP_SECRET_KEY and
# DEMO_ACCOUNTS_PASSWORD below. `docker compose up` stops and says so while the first is
# empty. AWS takes neither of them from here (docs/12 section 8).

APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=INFO

# The demo clock is allowed only when this is true (docs/04 R-DEMO). In demo mode the
# database step seeds demo pharmacies, which need the catalog: build it first
# (backend/data/moph/catalog.csv and catalog.json, docs/12 section 7), or set false.
DEMO_MODE=true

# PostgreSQL (the local container, reachable on this machine at port 5433)
POSTGRES_USER=dawalink
POSTGRES_PASSWORD=dawalink-local-only
POSTGRES_DB=dawalink

# The database has four logins (docs/05 §7). POSTGRES_USER above is the master login;
# `prepare_db` creates the other three with these passwords.
MIGRATOR_DB_PASSWORD=migrator-local-only
APP_DB_PASSWORD=app-local-only
RETENTION_DB_PASSWORD=retention-local-only

# Used when you run the backend or its tests on your machine, outside Docker.
# Inside Docker, docker-compose.yml points the services at the "postgres" container.
# 127.0.0.1, not "localhost": on Windows "localhost" can try IPv6 first and wait for seconds.
# DATABASE_URL is the app's own login: the API and the worker use only this one.
DATABASE_URL=postgresql+psycopg://dawalink_app:app-local-only@127.0.0.1:5433/dawalink
DATABASE_ADMIN_URL=postgresql+psycopg://dawalink:dawalink-local-only@127.0.0.1:5433/dawalink
DATABASE_MIGRATOR_URL=postgresql+psycopg://dawalink_migrator:migrator-local-only@127.0.0.1:5433/dawalink
DATABASE_RETENTION_URL=postgresql+psycopg://dawalink_retention:retention-local-only@127.0.0.1:5433/dawalink

# The website's address: the only site the API accepts browser calls from.
WEBSITE_URL=http://localhost:5173

# The app's own secret: admins' two-factor secrets are encrypted with it, and the network
# address of a sign-up is hashed with it. Required: the API refuses to start without it.
# Make your own and paste it here:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
# The one password of the demo accounts (client01@demo.dawalink.test,
# pharmacy01@demo.dawalink.test, ...). `prepare_db` sets it in demo mode. Empty: they
# can't log in. Make one (it has a capital, a small letter, a number and a symbol):
#   python -c "import secrets;print(secrets.token_urlsafe(12)+'-Aa1')"
DEMO_ACCOUNTS_PASSWORD=

# --- The assistant (docs/07 section 10) ---
# Which model the agent thinks with. "none" switches it off, so nothing is ever spent
# by accident; search and everything else still work.
#   anthropic: Claude, paid from the API credit. Needs LLM_MODEL and ANTHROPIC_API_KEY.
#   ollama:    the free local model (Ollama must be running on this machine). It is
#              too small to judge the agent: use it only without a network.
LLM_PROVIDER=none
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=medium
# The month's LLM budget in USD. A day may use 10% of it; reaching either stops the
# assistant until the next day or month (docs/04 N-46). 20 is plenty for development: a
# day can then spend $2 at most (decision log BLD-D13).
LLM_MONTHLY_BUDGET_USD=20
# Secret. Create it at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# Road travel times from OpenRouteService. Secret; a free key from
# https://account.heigit.org. Empty: every travel time is a straight-line estimate.
ORS_API_KEY=

# Agent traces in Langfuse Cloud. Secret; a free account at https://cloud.langfuse.com.
# Empty: turns are recorded in our own tables only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The address Langfuse gives with the keys (EU: cloud.langfuse.com, US: us.cloud.langfuse.com).
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Email (docs/12 section 9) ---
# Locally docker-compose.yml sends the worker's emails to the mail catcher (mailpit,
# http://localhost:8025), with no login: leave these as they are. In AWS the worker
# sends through Amazon SES and refuses to start without all of them; there they are
# set in the task definition, never here:
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=          (SES's SMTP user name; secret)
# SMTP_PASSWORD=      (SES's SMTP password; secret)
# EMAIL_FROM=DawaLink <the address SES has verified>
# (SMTP_STARTTLS is on by itself whenever SMTP_USER is set.)

# The API's address, built into the website.
VITE_API_URL=http://localhost:8000
