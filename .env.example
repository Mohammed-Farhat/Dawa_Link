# Local development settings. Copy this file to .env; never commit .env.
# Nothing here is a real secret: these values only work on your own machine.

APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=INFO

# The demo clock is allowed only when this is true (docs/04 R-DEMO).
DEMO_MODE=true

# PostgreSQL (the local container, reachable on this machine at port 5433)
POSTGRES_USER=dawalink
POSTGRES_PASSWORD=dawalink-local-only
POSTGRES_DB=dawalink

# The database has four logins (docs/05 §7). POSTGRES_USER above is the master login;
# `prepare_db` creates the other three with these passwords.
MIGRATOR_DB_PASSWORD=migrator-local-only
APP_DB_PASSWORD=app-local-only
RETENTION_DB_PASSWORD=retention-local-only

# Used when you run the backend or its tests on your machine, outside Docker.
# Inside Docker, docker-compose.yml points the services at the "postgres" container.
# 127.0.0.1, not "localhost": on Windows "localhost" can try IPv6 first and wait for seconds.
# DATABASE_URL is the app's own login: the API and the worker use only this one.
DATABASE_URL=postgresql+psycopg://dawalink_app:app-local-only@127.0.0.1:5433/dawalink
DATABASE_ADMIN_URL=postgresql+psycopg://dawalink:dawalink-local-only@127.0.0.1:5433/dawalink
DATABASE_MIGRATOR_URL=postgresql+psycopg://dawalink_migrator:migrator-local-only@127.0.0.1:5433/dawalink
DATABASE_RETENTION_URL=postgresql+psycopg://dawalink_retention:retention-local-only@127.0.0.1:5433/dawalink

# The website's address: the only site the API accepts browser calls from.
WEBSITE_URL=http://localhost:5173

# The API's address, built into the website.
VITE_API_URL=http://localhost:8000
